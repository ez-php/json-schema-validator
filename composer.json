{
  "name": "ez-php/json-schema-validator",
  "version": "2.6.2",
  "description": "Validates decoded JSON against the JSON Schema subset ez-php/json-schema generates, with JSON Pointer error paths",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andreas Uretschnig",
      "email": "andreas.uretschnig@gmail.com"
    }
  ],
  "keywords": ["json-schema", "validation", "json-pointer", "php", "ez-php"],
  "homepage": "https://github.com/ez-php/json-schema-validator",
  "support": {
    "issues": "https://github.com/ez-php/json-schema-validator/issues",
    "source": "https://github.com/ez-php/json-schema-validator"
  },
  "require": {
    "php": "^8.5"
  },
  "suggest": {
    "ez-php/contracts": "Needed for Http\\JsonSchemaMiddleware (request body validation)",
    "ez-php/http": "Needed for Http\\JsonSchemaMiddleware (request body validation)",
    "ez-php/json-schema": "Needed for Http\\JsonSchemaMiddleware schemas generated from request classes"
  },
  "require-dev": {
    "ez-php/docker": "^2.6.0",
    "ez-php/json-schema": "^2.6.0",
    "ez-php/contracts": "^2.6.0",
    "ez-php/http": "^2.6.0",
    "phpunit/phpunit": "^13.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "EzPhp\\JsonSchemaValidator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "analyse": "phpstan analyse",
    "test": "phpunit",
    "full": "composer analyse && composer cs && composer test"
  }
}
